{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window permissions with http(s)-only external link opening",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-default-urls",
      "allow": [
        { "url": "http://*" },
        { "url": "https://*" }
      ]
    }
  ]
}
