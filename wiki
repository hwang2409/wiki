#!/usr/bin/env python3
"""wiki — structured vault ops for agents.

Hot-path writes with validation, so conventions hold mechanically:

  wiki todo add "text" [--priority P1] [--section Todo]
  wiki todo move "substring" --to "In Progress"
  wiki todo complete "substring"
  wiki log-done "project: summary (links)"
  wiki note new <topic>/<slug> --type til --hook "map hook line" [--title T] [--tags a,b]
  wiki lint

Raw markdown editing stays allowed for note prose; these commands cover the
transactional flows (todo/done/map) where drift actually happens.
"""

from __future__ import annotations

import argparse
import datetime
import json
import os
import re
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent / "backend" / "app"))
import vaultops  # noqa: E402
import knowledge  # noqa: E402

VAULT = Path(
    os.environ.get("WIKI_VAULT_DIR") or Path(__file__).resolve().parent / "vault"
).expanduser().absolute()
TODO = VAULT / "todo.md"
DONE = VAULT / "log" / "done.md"
MAP = VAULT / "map.md"
# Env override parity with backend/app/accounts.py — lets tests point the CLI
# at a temp registry without editing this file.
AGENT_REGISTRY = Path(
    os.environ.get("WIKI_AGENT_REGISTRY_PATH") or "/tmp/agent-registry.json"
)
AGENT_ARCHIVE = Path(
    os.environ.get("WIKI_AGENT_ARCHIVE_DIR") or Path.home() / "me" / "fun" / "agent-archive"
)
AGENT_ROLES = {"plan", "implement", "review"}
AGENT_OUTCOMES = {"merged", "closed", "plan-ready", "abandoned", "handoff"}

SECTION_RE = re.compile(r"^([^-*\s#>][^:]*):\s*$")
ITEM_RE = re.compile(r"^- (.+)$")
WIKILINK_RE = re.compile(r"\[\[([^\][|\n]+?)(?:\|[^\][\n]*)?\]\]")
CODE_FENCE_RE = re.compile(r"```[\s\S]*?```|~~~[\s\S]*?~~~")
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")


def strip_code(content: str) -> str:
    """Remove fenced blocks and inline code so quoted link syntax isn't scanned."""
    return INLINE_CODE_RE.sub("", CODE_FENCE_RE.sub("", content))
FRONTMATTER_KEYS = ("type", "tags", "created", "updated")
NOTE_TYPES = {"campaign", "decision", "til", "reference", "log"}

# Files that legitimately have no frontmatter
FRONTMATTER_EXEMPT = {"map.md"}


def today() -> str:
    return datetime.date.today().isoformat()


def fail(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def read_lines(path: Path) -> list[str]:
    if not path.exists():
        fail(f"{path} does not exist")
    return path.read_text(encoding="utf-8").split("\n")


def write_lines(path: Path, lines: list[str]) -> None:
    text = "\n".join(lines)
    if not text.endswith("\n"):
        text += "\n"
    path.write_text(text, encoding="utf-8")


def bump_updated(lines: list[str]) -> None:
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                break
            if lines[i].startswith("updated:"):
                lines[i] = f"updated: {today()}"
                break


def section_bounds(lines: list[str], section: str) -> tuple[int, int] | None:
    """(header index, exclusive end) for a `Label:` section."""
    header = None
    in_frontmatter = False
    for i, line in enumerate(lines):
        if i == 0 and line.strip() == "---":
            in_frontmatter = True
            continue
        if in_frontmatter:
            if line.strip() == "---":
                in_frontmatter = False
            continue
        if line.strip() == f"{section}:":
            header = i
            break
    if header is None:
        return None
    end = len(lines)
    for j in range(header + 1, len(lines)):
        if SECTION_RE.match(lines[j]):
            end = j
            break
    return header, end


def insert_todo_line(lines: list[str], section: str, text: str) -> list[str]:
    bounds = section_bounds(lines, section)
    if bounds is None:
        fail(f'section "{section}:" not found in todo.md')
    header, end = bounds
    last_item = None
    for i in range(header + 1, end):
        if ITEM_RE.match(lines[i]):
            last_item = i
    if last_item is not None:
        insert_at = last_item + 1
    else:
        insert_at = header + 1
        if insert_at < len(lines) and lines[insert_at].strip() == "":
            insert_at += 1
    lines.insert(insert_at, f"- {text}")
    return lines


def find_todo_item(lines: list[str], needle: str) -> int:
    matches = [
        i
        for i, line in enumerate(lines)
        if ITEM_RE.match(line) and needle.lower() in line.lower()
    ]
    if not matches:
        fail(f'no todo item matches "{needle}"')
    if len(matches) > 1:
        listing = "\n".join(f"  {lines[i]}" for i in matches)
        fail(f'"{needle}" matches {len(matches)} items — be more specific:\n{listing}')
    return matches[0]


def cmd_todo_add(args: argparse.Namespace) -> None:
    text = args.text.strip()
    if args.priority:
        priority = args.priority.upper()
        if not re.fullmatch(r"P\d", priority):
            fail("--priority must look like P0/P1/P2")
        text = f"[{priority}] {text}"
    lines = read_lines(TODO)
    lines = insert_todo_line(lines, args.section, text)
    bump_updated(lines)
    write_lines(TODO, lines)
    print(f'added to {args.section}: - {text}')


def cmd_todo_move(args: argparse.Namespace) -> None:
    lines = read_lines(TODO)
    index = find_todo_item(lines, args.match)
    item = lines.pop(index)
    lines = insert_todo_line(lines, args.to, ITEM_RE.match(item).group(1))
    bump_updated(lines)
    write_lines(TODO, lines)
    print(f"moved to {args.to}: {item}")


def append_done_line(text: str) -> str:
    """Insert under today's `## YYYY-MM-DD` header (newest section at top)."""
    project_match = re.match(r"^([\w-]+):\s*(.+)$", text)
    entry = (
        f"- **{project_match.group(1)}** — {project_match.group(2)}"
        if project_match
        else f"- {text}"
    )

    lines = read_lines(DONE)
    header = f"## {today()}"

    start = 0
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                start = i + 1
                break

    first_h2 = None
    for i in range(start, len(lines)):
        if lines[i].startswith("## "):
            first_h2 = i
            break

    if first_h2 is not None and lines[first_h2].strip() == header:
        at = first_h2 + 1
        if at < len(lines) and lines[at].strip() == "":
            at += 1
        lines.insert(at, entry)
    else:
        at = first_h2 if first_h2 is not None else len(lines)
        lines[at:at] = [header, "", entry, ""]

    bump_updated(lines)
    write_lines(DONE, lines)
    return entry


def cmd_todo_complete(args: argparse.Namespace) -> None:
    lines = read_lines(TODO)
    index = find_todo_item(lines, args.match)
    item = lines.pop(index)
    bump_updated(lines)
    write_lines(TODO, lines)
    summary = re.sub(r"^\[P\d\]\s*", "", ITEM_RE.match(item).group(1))
    entry = append_done_line(summary)
    print(f"completed: {item}\nlogged: {entry}")


def cmd_log_done(args: argparse.Namespace) -> None:
    entry = append_done_line(args.text.strip())
    print(f"logged: {entry}")


def map_insert(slug: str, topic: str, hook: str) -> None:
    lines = read_lines(MAP)
    entry = f"- [[{slug}]] — {hook}"

    # Prefer inserting after the last map line that links to a note in the
    # same topic folder.
    topic_slugs = {
        p.stem
        for p in (VAULT / topic).glob("*.md")
        if p.stem != slug
    } if (VAULT / topic).is_dir() else set()

    last_topic_line = None
    for i, line in enumerate(lines):
        for m in WIKILINK_RE.finditer(line):
            if m.group(1).strip() in topic_slugs:
                last_topic_line = i
    if last_topic_line is not None:
        lines.insert(last_topic_line + 1, entry)
        write_lines(MAP, lines)
        return

    # Otherwise create a topic section before "## Families" (or at EOF).
    insert_at = len(lines)
    for i, line in enumerate(lines):
        if line.startswith("## Families"):
            insert_at = i
            break
    block = [f"## {topic.capitalize()}", "", entry, ""]
    lines[insert_at:insert_at] = block
    write_lines(MAP, lines)


def cmd_note_new(args: argparse.Namespace) -> None:
    rel = args.path.strip().removesuffix(".md")
    if "/" not in rel:
        fail("path must look like <topic>/<slug>")
    topic, slug = rel.rsplit("/", 1)
    if not re.fullmatch(r"[a-z0-9-]+", slug):
        fail("slug must be kebab-case")
    if args.type not in NOTE_TYPES:
        fail(f"--type must be one of {sorted(NOTE_TYPES)}")

    target = VAULT / f"{rel}.md"
    if target.exists():
        fail(f"{target} already exists")

    title = args.title or slug.replace("-", " ").title()
    tags = [t.strip() for t in (args.tags or topic).split(",") if t.strip()]
    body = (
        "---\n"
        f"type: {args.type}\n"
        f"tags: [{', '.join(tags)}]\n"
        f"created: {today()}\n"
        f"updated: {today()}\n"
        "---\n"
        "\n"
        f"# {title}\n"
        "\n"
    )
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(body, encoding="utf-8")
    map_insert(slug, topic, args.hook)
    print(f"created {target.relative_to(VAULT.parent)}\nmap updated: [[{slug}]]")


def read_registry() -> dict:
    import json

    if not AGENT_REGISTRY.exists():
        return {}
    try:
        return json.loads(AGENT_REGISTRY.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def is_headless_current(entry: object) -> bool:
    if not isinstance(entry, dict):
        return False
    current = entry.get("current")
    return isinstance(current, dict) and isinstance(current.get("run_id"), str)


def fail_headless_ownership(command: str, agent_id: str) -> None:
    fail(
        f"{command} cannot mutate supervisor-owned headless run {agent_id}; "
        "use the wiki app/backend lifecycle controls instead"
    )


def write_registry(registry: dict) -> None:
    import json
    import tempfile

    # tempfile dir = registry parent so os.rename stays atomic on the same fs.
    target_dir = AGENT_REGISTRY.parent
    target_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", dir=str(target_dir), suffix=".agent-registry", delete=False, encoding="utf-8"
    ) as handle:
        json.dump(registry, handle, indent=1)
        temp_name = handle.name
    Path(temp_name).rename(AGENT_REGISTRY)


def now_iso() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def cmd_agent_register(args: argparse.Namespace) -> None:
    ticket = args.ticket.strip().upper()
    if args.role not in AGENT_ROLES:
        fail(f"--role must be one of {sorted(AGENT_ROLES)}")
    if args.kind not in {"cdx", "cc"}:
        fail("--kind must be cdx or cc")

    registry = read_registry()
    entry = registry.get(ticket, {"history": []})
    if is_headless_current(entry):
        fail_headless_ownership("wiki agent register", ticket)

    current = entry.get("current")
    if current:
        current["ended_at"] = now_iso()
        current["outcome"] = "handoff"
        entry.setdefault("history", []).append(current)

    entry["current"] = {
        "window": args.window,
        "kind": args.kind,
        "role": args.role,
        "model": args.model,
        "worktree": args.worktree,
        "log": args.log,
        "orch": args.orch,
        "session": len(entry.get("history", [])) + 1,
        "spawned_at": now_iso(),
    }
    registry[ticket] = entry
    write_registry(registry)
    print(f"registered {ticket}: {args.kind} {args.role} session {entry['current']['session']} ({args.window})")


def newest_archive_dir(ticket: str) -> Path | None:
    ticket_dir = AGENT_ARCHIVE / ticket
    if not ticket_dir.is_dir():
        return None
    sessions = sorted(
        (d for d in ticket_dir.iterdir() if d.is_dir() and re.fullmatch(r"\d{8}-\d{6}", d.name)),
        reverse=True,
    )
    return sessions[0] if sessions else None


def persist_outcome(ticket: str, outcome: str | None, entry: dict | None = None) -> Path | None:
    import json

    session_dir = newest_archive_dir(ticket)
    if session_dir is None:
        return None
    meta_path = session_dir / "meta.json"
    meta = {}
    try:
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        pass
    if outcome:
        meta["outcome"] = outcome
    meta["ended_at"] = now_iso()
    if entry:
        meta["worker"] = entry.get("current")
        meta["history"] = entry.get("history", [])
    meta_path.write_text(json.dumps(meta, indent=1) + "\n", encoding="utf-8")
    return meta_path


def maybe_kill_agent_window(entry: dict, keep_window: bool = False) -> str | None:
    current = entry.get("current")
    if not isinstance(current, dict):
        return None
    window_id = current.get("window")
    if not isinstance(window_id, str) or not re.fullmatch(r"@\d+", window_id):
        return None
    if keep_window:
        return f"kept window {window_id}"
    try:
        result = subprocess.run(
            ["tmux", "list-windows", "-a", "-F", "#{window_id}"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return f"window already gone: {window_id}"
    if result.returncode != 0:
        return f"window already gone: {window_id}"
    live_windows = {line.strip() for line in result.stdout.splitlines() if line.strip()}
    if window_id not in live_windows:
        return f"window already gone: {window_id}"
    try:
        killed = subprocess.run(
            ["tmux", "kill-window", "-t", window_id],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return f"window already gone: {window_id}"
    if killed.returncode != 0:
        return f"window already gone: {window_id}"
    return f"killed window {window_id}"


def cmd_agent_done(args: argparse.Namespace) -> None:
    ticket = args.ticket.strip().upper()
    if args.outcome and args.outcome not in AGENT_OUTCOMES:
        fail(f"--outcome must be one of {sorted(AGENT_OUTCOMES)}")
    registry = read_registry()
    if ticket not in registry:
        fail(f"{ticket} not in registry")
    entry = registry[ticket]
    if is_headless_current(entry):
        fail_headless_ownership("wiki agent done", ticket)
    del registry[ticket]
    write_registry(registry)
    meta_path = persist_outcome(ticket, args.outcome, entry)
    line = f"deregistered {ticket}" + (f" (outcome: {args.outcome})" if args.outcome else "")
    if meta_path:
        line += f"; persisted {meta_path}"
    else:
        line += "; WARNING: no archive dir found — archive BEFORE `wiki agent done` so outcome persists"
    print(line)
    window_line = maybe_kill_agent_window(entry, keep_window=args.keep_window)
    if window_line:
        print(window_line)


def cmd_agent_update(args: argparse.Namespace) -> None:
    ticket = args.ticket.strip().upper()
    registry = read_registry()
    entry = registry.get(ticket)
    if not entry or not entry.get("current"):
        fail(f"{ticket} not in registry")
    if is_headless_current(entry):
        fail_headless_ownership("wiki agent update", ticket)
    current = entry["current"]
    # (arg-name, registry-key) — `--session` writes `session_id` to avoid the
    # collision with the integer session-count field written by `register`.
    fields = (
        ("window", "window"),
        ("kind", "kind"),
        ("role", "role"),
        ("model", "model"),
        ("worktree", "worktree"),
        ("log", "log"),
        ("orch", "orch"),
        ("session", "session_id"),
    )
    changed = []
    for arg_name, reg_key in fields:
        value = getattr(args, arg_name)
        if value is not None:
            current[reg_key] = value
            changed.append(reg_key)
    if not changed:
        fail(
            "nothing to update — pass at least one of "
            + ", ".join(f"--{arg}" for arg, _ in fields)
        )
    if current.get("role") is not None and current["role"] not in AGENT_ROLES:
        fail(f"--role must be one of {sorted(AGENT_ROLES)}")
    write_registry(registry)
    print(f"updated {ticket}: " + ", ".join(f"{k}={current[k]}" for k in changed))


def cmd_agent_orch(args: argparse.Namespace) -> None:
    import os

    orch_id = args.id.strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", orch_id):
        fail("orch id must be alphanumeric/dash/underscore")
    session_id = os.environ.get("CLAUDE_CODE_SESSION_ID")
    cwd = Path.cwd()
    transcript = None
    if session_id:
        escaped = str(cwd).replace("/", "-").replace(".", "-")
        candidate = Path.home() / ".claude" / "projects" / escaped / f"{session_id}.jsonl"
        transcript = str(candidate)
    registry = read_registry()
    if is_headless_current(registry.get(orch_id)):
        fail_headless_ownership("wiki agent orch", orch_id)
    orchs = registry.setdefault("_orchestrators", {})
    orchs[orch_id] = {
        "window": args.window,
        "model": args.model,
        "cwd": str(cwd),
        "session_id": session_id,
        "transcript": transcript,
        "spawned_at": now_iso(),
    }
    write_registry(registry)
    note = transcript if transcript else "WARNING: CLAUDE_CODE_SESSION_ID not set — no transcript mapping"
    print(f"orchestrator {orch_id} registered ({note})")


def cmd_agent_orch_done(args: argparse.Namespace) -> None:
    orch_id = args.id.strip()
    registry = read_registry()
    orchs = registry.get("_orchestrators", {})
    if orch_id not in orchs:
        fail(f"{orch_id} not registered")
    del orchs[orch_id]
    write_registry(registry)
    print(f"orchestrator {orch_id} deregistered")


def cmd_agent_outcome(args: argparse.Namespace) -> None:
    ticket = args.ticket.strip().upper()
    if args.outcome not in AGENT_OUTCOMES:
        fail(f"outcome must be one of {sorted(AGENT_OUTCOMES)}")
    meta_path = persist_outcome(ticket, args.outcome)
    if meta_path is None:
        fail(f"no archive dir for {ticket} under {AGENT_ARCHIVE}")
    print(f"marked {ticket} {args.outcome} ({meta_path})")


def cmd_agent_list(_args: argparse.Namespace) -> None:
    registry = read_registry()
    if not registry:
        print("no registered agents")
        return
    for orch_id, orch in sorted(registry.get("_orchestrators", {}).items()):
        print(f"[orch] {orch_id}: {orch.get('window', '?')} {orch.get('cwd', '?')}")
    for ticket, entry in sorted(registry.items()):
        if ticket.startswith("_"):
            continue
        current = entry.get("current") or {}
        sessions = len(entry.get("history", [])) + (1 if current else 0)
        print(
            f"{ticket}: {current.get('kind', '?')} {current.get('role', '?')} "
            f"{current.get('window', '?')} (session {current.get('session', '?')}/{sessions})"
        )


def cmd_note_rename(args: argparse.Namespace) -> None:
    old = args.old.removesuffix(".md") + ".md"
    new = args.new.removesuffix(".md") + ".md"
    try:
        changed = vaultops.rename_note(VAULT, old, new)
    except vaultops.VaultOpError as exc:
        fail(str(exc))
    print(f"renamed {old} -> {new}")
    if len(changed) > 1:
        print("wikilinks rewritten in: " + ", ".join(changed[1:]))


def cmd_note_delete(args: argparse.Namespace) -> None:
    rel = args.path.removesuffix(".md") + ".md"
    try:
        changed = vaultops.delete_note(VAULT, rel)
    except vaultops.VaultOpError as exc:
        fail(str(exc))
    print(f"deleted {rel}" + (" (map line pruned)" if "map.md" in changed else ""))


def parse_frontmatter(lines: list[str]) -> dict[str, str] | None:
    if not lines or lines[0].strip() != "---":
        return None
    fields: dict[str, str] = {}
    for line in lines[1:]:
        if line.strip() == "---":
            return fields
        if ":" in line and not line.startswith((" ", "\t")):
            key, _, value = line.partition(":")
            fields[key.strip()] = value.strip()
    return None


def cmd_lint(_args: argparse.Namespace) -> None:
    errors: list[str] = []
    warnings: list[str] = []

    notes = {
        p.relative_to(VAULT).as_posix(): p.read_text(encoding="utf-8")
        for p in sorted(VAULT.rglob("*.md"))
        if ".obsidian" not in p.parts
    }

    # Frontmatter
    for rel, content in notes.items():
        name = Path(rel).name
        if name in FRONTMATTER_EXEMPT or rel.startswith("log/") and re.fullmatch(
            r"log/\d{4}-\d{2}-\d{2}\.md", rel
        ):
            continue
        fm = parse_frontmatter(content.split("\n"))
        if fm is None:
            errors.append(f"{rel}: missing frontmatter")
            continue
        for key in FRONTMATTER_KEYS:
            if key not in fm:
                errors.append(f"{rel}: frontmatter missing `{key}`")
        if fm.get("type") and fm["type"] not in NOTE_TYPES:
            errors.append(f"{rel}: unknown type `{fm['type']}`")
        for key in ("created", "updated"):
            value = fm.get(key, "")
            if value and not re.fullmatch(r"\d{4}-\d{2}-\d{2}", value):
                errors.append(f"{rel}: `{key}` not YYYY-MM-DD")

    # Map completeness (both directions). Families (log/, <topic>/til|decisions|
    # features|specs/) are covered by pattern lines, not per-file entries.
    family_re = re.compile(r"^(log/|[^/]+/(til|decisions|features|specs)/)")
    map_content = notes.get("map.md", "")
    map_slugs = {m.group(1).strip() for m in WIKILINK_RE.finditer(map_content)}
    all_slugs = {Path(rel).stem: rel for rel in notes}
    for rel in notes:
        if rel == "map.md" or family_re.match(rel):
            continue
        if Path(rel).stem not in map_slugs:
            errors.append(f"map.md: missing entry for {rel}")
    for slug in map_slugs:
        if slug not in all_slugs:
            errors.append(f"map.md: [[{slug}]] points at no note")

    # todo.md shape
    todo_rel = "todo.md"
    if todo_rel in notes:
        in_fm = False
        for i, line in enumerate(notes[todo_rel].split("\n"), start=1):
            stripped = line.strip()
            if i == 1 and stripped == "---":
                in_fm = True
                continue
            if in_fm:
                if stripped == "---":
                    in_fm = False
                continue
            if not stripped or SECTION_RE.match(line) or ITEM_RE.match(line):
                continue
            errors.append(f"todo.md:{i}: unexpected line: {line!r}")

    # done.md shape
    done_rel = "log/done.md"
    if done_rel in notes:
        body_started = False
        in_fm = False
        for i, line in enumerate(notes[done_rel].split("\n"), start=1):
            stripped = line.strip()
            if i == 1 and stripped == "---":
                in_fm = True
                continue
            if in_fm:
                if stripped == "---":
                    in_fm = False
                continue
            if not stripped or stripped.startswith("#"):
                continue
            body_started = True
            # Two sanctioned shapes: flat dated lines, or `- entry` under a
            # `## YYYY-MM-DD` heading.
            if not stripped.startswith("- "):
                errors.append(f"log/done.md:{i}: bad entry format: {line!r}")
        if not body_started:
            warnings.append("log/done.md: no entries")

    # Unresolved wikilinks (warning — an unresolved link marks a future note)
    for rel, content in notes.items():
        for m in WIKILINK_RE.finditer(strip_code(content)):
            slug = m.group(1).strip()
            if slug not in all_slugs:
                warnings.append(f"{rel}: unresolved [[{slug}]]")

    for warning in sorted(set(warnings)):
        print(f"warn: {warning}")
    for error in errors:
        print(f"ERROR: {error}")
    if errors:
        print(f"\n{len(errors)} error(s), {len(set(warnings))} warning(s)")
        sys.exit(1)
    print(f"vault clean — 0 errors, {len(set(warnings))} warning(s)")


def _knowledge_index() -> knowledge.KnowledgeIndex:
    return knowledge.KnowledgeIndex.from_env(vault_dir=VAULT)


def cmd_search(args: argparse.Namespace) -> None:
    try:
        result = _knowledge_index().search(
            args.query,
            ticket=args.ticket,
            kind=args.kind,
            event_type=args.event_type,
            since=args.since,
            limit=args.limit,
        )
    except knowledge.KnowledgeQueryError as exc:
        fail(str(exc))
    except knowledge.KnowledgeUnavailable as exc:
        fail(f"knowledge database unavailable: {exc}")
    if args.json:
        print(json.dumps(result, ensure_ascii=False, sort_keys=True))
        return
    if result["rebuilding"]:
        print("knowledge index is rebuilding; results may be partial", file=sys.stderr)
    for row in result["results"]:
        print(f"{row['citation']}  score={row['score']:.8f}")
        snippet = str(row.get("snippet") or "").strip()
        if snippet:
            print(f"  {snippet}")


def cmd_links_backlinks(args: argparse.Namespace) -> None:
    try:
        result = _knowledge_index().backlinks(args.note)
    except knowledge.KnowledgeQueryError as exc:
        fail(str(exc))
    except knowledge.KnowledgeUnavailable as exc:
        fail(f"knowledge database unavailable: {exc}")
    for path in result["backlinks"]:
        print(path)


def cmd_links_orphans(_args: argparse.Namespace) -> None:
    try:
        result = _knowledge_index().orphans()
    except knowledge.KnowledgeQueryError as exc:
        fail(str(exc))
    except knowledge.KnowledgeUnavailable as exc:
        fail(f"knowledge database unavailable: {exc}")
    for path in result["orphans"]:
        print(path)


def cmd_links_unresolved(_args: argparse.Namespace) -> None:
    try:
        result = _knowledge_index().unresolved()
    except knowledge.KnowledgeQueryError as exc:
        fail(str(exc))
    except knowledge.KnowledgeUnavailable as exc:
        fail(f"knowledge database unavailable: {exc}")
    for row in result["unresolved"]:
        print(f"{row['src_note']} -> [[{row['dst_name']}]]")


def cmd_index_rebuild(_args: argparse.Namespace) -> None:
    try:
        stats = _knowledge_index().rebuild()
    except knowledge.KnowledgeError as exc:
        fail(f"knowledge database unavailable: {exc}")
    print(json.dumps(stats.to_dict(), sort_keys=True))


def main() -> None:
    parser = argparse.ArgumentParser(prog="wiki", description=__doc__)
    sub = parser.add_subparsers(dest="command", required=True)

    todo = sub.add_parser("todo", help="todo.md operations")
    todo_sub = todo.add_subparsers(dest="todo_command", required=True)

    add = todo_sub.add_parser("add", help="add an item")
    add.add_argument("text")
    add.add_argument("--priority", help="P0/P1/P2 — prepended as [Pn]")
    add.add_argument("--section", default="Todo", help='default "Todo"')
    add.set_defaults(func=cmd_todo_add, refresh_knowledge=True)

    move = todo_sub.add_parser("move", help="move an item between sections")
    move.add_argument("match", help="unique substring of the item")
    move.add_argument("--to", required=True, help="target section")
    move.set_defaults(func=cmd_todo_move, refresh_knowledge=True)

    complete = todo_sub.add_parser("complete", help="remove item + log to done.md")
    complete.add_argument("match", help="unique substring of the item")
    complete.set_defaults(func=cmd_todo_complete, refresh_knowledge=True)

    log_done = sub.add_parser("log-done", help="append a dated line to log/done.md")
    log_done.add_argument("text")
    log_done.set_defaults(func=cmd_log_done, refresh_knowledge=True)

    note = sub.add_parser("note", help="note operations")
    note_sub = note.add_subparsers(dest="note_command", required=True)
    new = note_sub.add_parser("new", help="create note with frontmatter + map entry")
    new.add_argument("path", help="<topic>/<slug> (no .md)")
    new.add_argument("--type", required=True, help="|".join(sorted(NOTE_TYPES)))
    new.add_argument("--hook", required=True, help="one-line map.md hook")
    new.add_argument("--title")
    new.add_argument("--tags", help="comma-separated; defaults to topic")
    new.set_defaults(func=cmd_note_new, refresh_knowledge=True)

    rename = note_sub.add_parser(
        "rename", help="move/rename note; rewrites [[wikilinks]] + map.md if slug changes"
    )
    rename.add_argument("old", help="current <topic>/<slug>")
    rename.add_argument("new", help="new <topic>/<slug>")
    rename.set_defaults(func=cmd_note_rename, refresh_knowledge=True)

    delete = note_sub.add_parser("delete", help="hard-delete note + prune map line (git = undo)")
    delete.add_argument("path", help="<topic>/<slug>")
    delete.set_defaults(func=cmd_note_delete, refresh_knowledge=True)

    agent = sub.add_parser("agent", help="worker registry ops (/tmp/agent-registry.json)")
    agent_sub = agent.add_subparsers(dest="agent_command", required=True)

    register = agent_sub.add_parser(
        "register", help="register a worker at spawn; re-register = handoff (archives prior session)"
    )
    register.add_argument("ticket")
    register.add_argument("--window", required=True, help="tmux window_id, e.g. @327")
    register.add_argument("--kind", required=True, help="cdx | cc")
    register.add_argument("--role", default="implement", help="plan | implement | review")
    register.add_argument("--model")
    register.add_argument("--worktree")
    register.add_argument("--log", help="/tmp pane log path")
    register.add_argument("--orch", help="owning orchestrator id (see `agent orch`)")
    register.set_defaults(func=cmd_agent_register)

    update = agent_sub.add_parser(
        "update", help="mutate a live worker's fields in place (no handoff/session bump — use for orch retrofits etc.)"
    )
    update.add_argument("ticket")
    update.add_argument("--window")
    update.add_argument("--kind")
    update.add_argument("--role")
    update.add_argument("--model")
    update.add_argument("--worktree")
    update.add_argument("--log")
    update.add_argument("--orch")
    update.add_argument(
        "--session",
        help="codex rollout session id (stored as current.session_id — watchdog writes after revival)",
    )
    update.set_defaults(func=cmd_agent_update)

    orch = agent_sub.add_parser("orch", help="register THIS Claude session as an orchestrator (reads CLAUDE_CODE_SESSION_ID)")
    orch.add_argument("id", help="short label, e.g. phoebe")
    orch.add_argument("--window", help="tmux window_id of the orchestrator, e.g. @120")
    orch.add_argument("--model", default="opus", help="Claude model for this orchestrator; default opus")
    orch.set_defaults(func=cmd_agent_orch)

    orch_done = agent_sub.add_parser("orch-done", help="deregister an orchestrator at session end")
    orch_done.add_argument("id")
    orch_done.set_defaults(func=cmd_agent_orch_done)

    done = agent_sub.add_parser("done", help="deregister at wrap-up (run AFTER archiving so outcome persists)")
    done.add_argument("ticket")
    done.add_argument("--outcome", help="merged | closed | plan-ready | abandoned")
    done.add_argument(
        "--keep-window",
        action="store_true",
        help="leave the recorded tmux window alive after archiving",
    )
    done.set_defaults(func=cmd_agent_done)

    outcome = agent_sub.add_parser("outcome", help="mark an archived ticket's outcome after the fact")
    outcome.add_argument("ticket")
    outcome.add_argument("outcome", help="merged | closed | plan-ready | abandoned")
    outcome.set_defaults(func=cmd_agent_outcome)

    agent_list = agent_sub.add_parser("list", help="print registered workers")
    agent_list.set_defaults(func=cmd_agent_list)

    lint = sub.add_parser("lint", help="validate vault conventions")
    lint.set_defaults(func=cmd_lint)

    search = sub.add_parser("search", help="search indexed vault notes and fleet runs")
    search.add_argument("query")
    search.add_argument("--ticket")
    search.add_argument("--kind", choices=("note", "run"))
    search.add_argument("--type", dest="event_type", help="normalized event type")
    search.add_argument("--since", help="YYYY-MM-DD")
    search.add_argument("--limit", type=int, default=20)
    search.add_argument("--json", action="store_true")
    search.set_defaults(func=cmd_search)

    links = sub.add_parser("links", help="query the indexed wikilink graph")
    links_sub = links.add_subparsers(dest="links_command", required=True)
    backlinks = links_sub.add_parser("backlinks", help="list notes linking to a note")
    backlinks.add_argument("note")
    backlinks.set_defaults(func=cmd_links_backlinks)
    orphans = links_sub.add_parser("orphans", help="list notes with no backlinks")
    orphans.set_defaults(func=cmd_links_orphans)
    unresolved = links_sub.add_parser("unresolved", help="list unresolved wikilinks")
    unresolved.set_defaults(func=cmd_links_unresolved)

    index = sub.add_parser("index", help="manage the rebuildable knowledge index")
    index_sub = index.add_subparsers(dest="index_command", required=True)
    rebuild = index_sub.add_parser("rebuild", help="drop and rebuild the full index")
    rebuild.set_defaults(func=cmd_index_rebuild)

    args = parser.parse_args()
    args.func(args)
    if getattr(args, "refresh_knowledge", False):
        # The transactional operation has already completed and printed its
        # response. This only enqueues work for the backend indexer.
        knowledge.enqueue_refresh(runtime_dir=os.environ.get("WIKI_AGENT_RUNTIME_DIR"))


if __name__ == "__main__":
    main()
