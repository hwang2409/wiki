        violations = graph_lint.validate_document(document, "steer")
    except graph_lint.GraphLintError as exc:
        fail(f"could not validate Steer: {exc}")
    if violations:
        formatted = "; ".join(f"{pointer}: {message}" for pointer, message in violations)
        fail(f"invalid Steer: {formatted}")


def _print_backend_call(path: str, payload: dict | None = None) -> dict:
    try:
