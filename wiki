).expanduser().absolute()
TODO = VAULT / "todo.md"
DONE = VAULT / "log" / "done.md"
MAP = VAULT / "map.md"
# Env override parity with backend/app/accounts.py — lets tests point the CLI
# at a temp registry without editing this file.
AGENT_REGISTRY = Path(
    os.environ.get("WIKI_AGENT_REGISTRY_PATH") or "/tmp/agent-registry.json"
)
AGENT_ARCHIVE = Path(
    os.environ.get("WIKI_AGENT_ARCHIVE_DIR") or Path.home() / "me" / "fun" / "agent-archive"
)
AGENT_STATUS_DIR = Path(os.environ.get("WIKI_AGENT_STATUS_DIR") or "/tmp/agent-status")
AGENT_ROLES = {"plan", "implement", "review"}
AGENT_OUTCOMES = {"merged", "closed", "plan-ready", "abandoned", "handoff"}

SECTION_RE = re.compile(r"^([^-*\s#>][^:]*):\s*$")
ITEM_RE = re.compile(r"^- (.+)$")
WIKILINK_RE = re.compile(r"\[\[([^\][|\n]+?)(?:\|[^\][\n]*)?\]\]")
CODE_FENCE_RE = re.compile(r"```[\s\S]*?```|~~~[\s\S]*?~~~")
INLINE_CODE_RE = re.compile(r"`[^`\n]*`")
CLI_TICKET_RE = re.compile(r"^[A-Za-z0-9_-]+$")
PR_REFERENCE_RE = re.compile(
    r"^(?:\d+|https://github\.com/[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+/pull/\d+)$"
)


def strip_code(content: str) -> str:
    """Remove fenced blocks and inline code so quoted link syntax isn't scanned."""
    return INLINE_CODE_RE.sub("", CODE_FENCE_RE.sub("", content))
FRONTMATTER_KEYS = ("type", "tags", "created", "updated")
NOTE_TYPES = {"campaign", "decision", "til", "reference", "log"}

# Files that legitimately have no frontmatter
FRONTMATTER_EXEMPT = {"map.md"}


def today() -> str:
    return datetime.date.today().isoformat()


def fail(message: str) -> None:
    print(f"error: {message}", file=sys.stderr)
    sys.exit(1)


def read_lines(path: Path) -> list[str]:
    if not path.exists():
        fail(f"{path} does not exist")
    return path.read_text(encoding="utf-8").split("\n")


def write_lines(path: Path, lines: list[str]) -> None:
    text = "\n".join(lines)
    if not text.endswith("\n"):
        text += "\n"
    path.write_text(text, encoding="utf-8")


def bump_updated(lines: list[str]) -> None:
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                break
            if lines[i].startswith("updated:"):
                lines[i] = f"updated: {today()}"
                break


def section_bounds(lines: list[str], section: str) -> tuple[int, int] | None:
    """(header index, exclusive end) for a `Label:` section."""
    header = None
    in_frontmatter = False
    for i, line in enumerate(lines):
        if i == 0 and line.strip() == "---":
            in_frontmatter = True
            continue
        if in_frontmatter:
            if line.strip() == "---":
                in_frontmatter = False
            continue
        if line.strip() == f"{section}:":
            header = i
            break
    if header is None:
        return None
    end = len(lines)
    for j in range(header + 1, len(lines)):
        if SECTION_RE.match(lines[j]):
            end = j
            break
    return header, end


def insert_todo_line(lines: list[str], section: str, text: str) -> list[str]:
    bounds = section_bounds(lines, section)
    if bounds is None:
        fail(f'section "{section}:" not found in todo.md')
    header, end = bounds
    last_item = None
    for i in range(header + 1, end):
        if ITEM_RE.match(lines[i]):
            last_item = i
    if last_item is not None:
        insert_at = last_item + 1
    else:
        insert_at = header + 1
        if insert_at < len(lines) and lines[insert_at].strip() == "":
            insert_at += 1
    lines.insert(insert_at, f"- {text}")
    return lines


def find_todo_item(lines: list[str], needle: str) -> int:
    matches = [
        i
        for i, line in enumerate(lines)
        if ITEM_RE.match(line) and needle.lower() in line.lower()
    ]
    if not matches:
        fail(f'no todo item matches "{needle}"')
    if len(matches) > 1:
        listing = "\n".join(f"  {lines[i]}" for i in matches)
        fail(f'"{needle}" matches {len(matches)} items — be more specific:\n{listing}')
    return matches[0]


def cmd_todo_add(args: argparse.Namespace) -> None:
    text = args.text.strip()
    if args.priority:
        priority = args.priority.upper()
        if not re.fullmatch(r"P\d", priority):
            fail("--priority must look like P0/P1/P2")
        text = f"[{priority}] {text}"
    lines = read_lines(TODO)
    if getattr(args, "if_missing", False) and f"- {text}" in lines:
        print(f"already in {args.section}: - {text}")
        return
    lines = insert_todo_line(lines, args.section, text)
    bump_updated(lines)
    write_lines(TODO, lines)
    print(f'added to {args.section}: - {text}')


def cmd_todo_move(args: argparse.Namespace) -> None:
    lines = read_lines(TODO)
    index = find_todo_item(lines, args.match)
    item = lines.pop(index)
    lines = insert_todo_line(lines, args.to, ITEM_RE.match(item).group(1))
    bump_updated(lines)
    write_lines(TODO, lines)
    print(f"moved to {args.to}: {item}")


def append_done_line(text: str) -> str:
    """Insert under today's `## YYYY-MM-DD` header (newest section at top)."""
    project_match = re.match(r"^([\w-]+):\s*(.+)$", text)
    entry = (
        f"- **{project_match.group(1)}** — {project_match.group(2)}"
        if project_match
        else f"- {text}"
    )

    lines = read_lines(DONE)
    header = f"## {today()}"

    start = 0
    if lines and lines[0].strip() == "---":
        for i in range(1, len(lines)):
            if lines[i].strip() == "---":
                start = i + 1
                break

    first_h2 = None
    for i in range(start, len(lines)):
        if lines[i].startswith("## "):
            first_h2 = i
            break

    if first_h2 is not None and lines[first_h2].strip() == header:
        at = first_h2 + 1
        if at < len(lines) and lines[at].strip() == "":
            at += 1
        lines.insert(at, entry)
    else:
        at = first_h2 if first_h2 is not None else len(lines)
        lines[at:at] = [header, "", entry, ""]

    bump_updated(lines)
    write_lines(DONE, lines)
    return entry


def cmd_todo_complete(args: argparse.Namespace) -> None:
    lines = read_lines(TODO)
    index = find_todo_item(lines, args.match)
    item = lines.pop(index)
    bump_updated(lines)
    write_lines(TODO, lines)
    if args.done_line:
        entry = append_done_line(args.done_line.strip())
        print(f"completed: {item}\nlogged: {entry}")
        return
    print(f"completed: {item}\nno done.md line written (use --done-line to add one)")


def cmd_log_done(args: argparse.Namespace) -> None:
    entry = append_done_line(args.text.strip())
    print(f"logged: {entry}")


def map_insert(slug: str, topic: str, hook: str) -> None:
    lines = read_lines(MAP)
    entry = f"- [[{slug}]] — {hook}"

    # Prefer inserting after the last map line that links to a note in the
    # same topic folder.
    topic_slugs = {
        p.stem
        for p in (VAULT / topic).glob("*.md")
        if p.stem != slug
    } if (VAULT / topic).is_dir() else set()

    last_topic_line = None
    for i, line in enumerate(lines):
        for m in WIKILINK_RE.finditer(line):
            if m.group(1).strip() in topic_slugs:
                last_topic_line = i
    if last_topic_line is not None:
        lines.insert(last_topic_line + 1, entry)
        write_lines(MAP, lines)
        return

    # Otherwise create a topic section before "## Families" (or at EOF).
    insert_at = len(lines)
    for i, line in enumerate(lines):
        if line.startswith("## Families"):
            insert_at = i
            break
    block = [f"## {topic.capitalize()}", "", entry, ""]
    lines[insert_at:insert_at] = block
    write_lines(MAP, lines)


def cmd_note_new(args: argparse.Namespace) -> None:
    rel = args.path.strip().removesuffix(".md")
    if "/" not in rel:
        fail("path must look like <topic>/<slug>")
    topic, slug = rel.rsplit("/", 1)
    if not re.fullmatch(r"[a-z0-9-]+", slug):
        fail("slug must be kebab-case")
    if args.type not in NOTE_TYPES:
        fail(f"--type must be one of {sorted(NOTE_TYPES)}")

    target = VAULT / f"{rel}.md"
    if target.exists():
        fail(f"{target} already exists")

    title = args.title or slug.replace("-", " ").title()
    tags = [t.strip() for t in (args.tags or topic).split(",") if t.strip()]
    body = (
        "---\n"
        f"type: {args.type}\n"
        f"tags: [{', '.join(tags)}]\n"
        f"created: {today()}\n"
        f"updated: {today()}\n"
        "---\n"
        "\n"
        f"# {title}\n"
        "\n"
    )
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(body, encoding="utf-8")
    map_insert(slug, topic, args.hook)
    print(f"created {target.relative_to(VAULT.parent)}\nmap updated: [[{slug}]]")


def read_registry() -> dict:
    import json

    if not AGENT_REGISTRY.exists():
        return {}
    try:
        return json.loads(AGENT_REGISTRY.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}


def is_headless_current(entry: object) -> bool:
    if not isinstance(entry, dict):
        return False
    current = entry.get("current")
    return isinstance(current, dict) and isinstance(current.get("run_id"), str)


def fail_headless_ownership(command: str, agent_id: str) -> None:
    fail(
        f"{command} cannot mutate supervisor-owned headless run {agent_id}; "
        "use the wiki app/backend lifecycle controls instead"
    )


def write_registry(registry: dict) -> None:
    import json
    import tempfile

    # tempfile dir = registry parent so os.rename stays atomic on the same fs.
    target_dir = AGENT_REGISTRY.parent
    target_dir.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        "w", dir=str(target_dir), suffix=".agent-registry", delete=False, encoding="utf-8"
    ) as handle:
        json.dump(registry, handle, indent=1)
        temp_name = handle.name
    Path(temp_name).rename(AGENT_REGISTRY)


def now_iso() -> str:
    return datetime.datetime.now().astimezone().isoformat(timespec="seconds")


def cmd_agent_register(args: argparse.Namespace) -> None:
    ticket = args.ticket.strip().upper()
    if args.role not in AGENT_ROLES:
        fail(f"--role must be one of {sorted(AGENT_ROLES)}")
    if args.kind not in {"cdx", "cc"}:
        fail("--kind must be cdx or cc")

    registry = read_registry()
    entry = registry.get(ticket, {"history": []})
    if is_headless_current(entry):
        fail_headless_ownership("wiki agent register", ticket)

    current = entry.get("current")
    if current:
        current["ended_at"] = now_iso()
        current["outcome"] = "handoff"
        entry.setdefault("history", []).append(current)

    entry["current"] = {
        "window": args.window,
        "kind": args.kind,
        "role": args.role,
        "model": args.model,
        "worktree": args.worktree,
        "log": args.log,
        "orch": args.orch,
        "session": len(entry.get("history", [])) + 1,
        "spawned_at": now_iso(),
    }
    registry[ticket] = entry
    write_registry(registry)
    print(f"registered {ticket}: {args.kind} {args.role} session {entry['current']['session']} ({args.window})")


def newest_archive_dir(ticket: str) -> Path | None:
    ticket_dir = AGENT_ARCHIVE / ticket
    if not ticket_dir.is_dir():
        return None
    sessions = sorted(
        (d for d in ticket_dir.iterdir() if d.is_dir() and re.fullmatch(r"\d{8}-\d{6}", d.name)),
        reverse=True,
    )
    return sessions[0] if sessions else None


def persist_outcome(ticket: str, outcome: str | None, entry: dict | None = None) -> Path | None:
    import json

    session_dir = newest_archive_dir(ticket)
    if session_dir is None:
        return None
    meta_path = session_dir / "meta.json"
    meta = {}
    try:
        meta = json.loads(meta_path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        pass
    if outcome:
        meta["outcome"] = outcome
    meta["ended_at"] = now_iso()
    if entry:
        meta["worker"] = entry.get("current")
        meta["history"] = entry.get("history", [])
    meta_path.write_text(json.dumps(meta, indent=1) + "\n", encoding="utf-8")
    return meta_path


def maybe_kill_agent_window(entry: dict, keep_window: bool = False) -> str | None:
    current = entry.get("current")
    if not isinstance(current, dict):
        return None
    window_id = current.get("window")
    if not isinstance(window_id, str) or not re.fullmatch(r"@\d+", window_id):
        return None
    if keep_window:
        return f"kept window {window_id}"
    try:
        result = subprocess.run(
            ["tmux", "list-windows", "-a", "-F", "#{window_id}"],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return f"window already gone: {window_id}"
    if result.returncode != 0:
        return f"window already gone: {window_id}"
    live_windows = {line.strip() for line in result.stdout.splitlines() if line.strip()}
    if window_id not in live_windows:
        return f"window already gone: {window_id}"
    try:
        killed = subprocess.run(
            ["tmux", "kill-window", "-t", window_id],
            capture_output=True,
            text=True,
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return f"window already gone: {window_id}"
    if killed.returncode != 0:
        return f"window already gone: {window_id}"
    return f"killed window {window_id}"


def cmd_agent_done(args: argparse.Namespace) -> None:
    ticket = args.ticket.strip().upper()
    if args.outcome and args.outcome not in AGENT_OUTCOMES:
        fail(f"--outcome must be one of {sorted(AGENT_OUTCOMES)}")
    registry = read_registry()
    if ticket not in registry:
        fail(f"{ticket} not in registry")
    entry = registry[ticket]
    if is_headless_current(entry):
        fail_headless_ownership("wiki agent done", ticket)
    del registry[ticket]
    write_registry(registry)
    meta_path = persist_outcome(ticket, args.outcome, entry)
    line = f"deregistered {ticket}" + (f" (outcome: {args.outcome})" if args.outcome else "")
    if meta_path:
        line += f"; persisted {meta_path}"
    else:
        line += "; WARNING: no archive dir found — archive BEFORE `wiki agent done` so outcome persists"
    print(line)
    window_line = maybe_kill_agent_window(entry, keep_window=args.keep_window)
    if window_line:
        print(window_line)


def cmd_agent_update(args: argparse.Namespace) -> None:
    ticket = args.ticket.strip().upper()
    registry = read_registry()
    entry = registry.get(ticket)
    if not entry or not entry.get("current"):
        fail(f"{ticket} not in registry")
    if is_headless_current(entry):
        fail_headless_ownership("wiki agent update", ticket)
    current = entry["current"]
    # (arg-name, registry-key) — `--session` writes `session_id` to avoid the
    # collision with the integer session-count field written by `register`.
    fields = (
        ("window", "window"),
        ("kind", "kind"),
        ("role", "role"),
        ("model", "model"),
        ("worktree", "worktree"),
        ("log", "log"),
        ("orch", "orch"),
        ("session", "session_id"),
    )
    changed = []
    for arg_name, reg_key in fields:
        value = getattr(args, arg_name)
        if value is not None:
            current[reg_key] = value
            changed.append(reg_key)
    if not changed:
        fail(
            "nothing to update — pass at least one of "
            + ", ".join(f"--{arg}" for arg, _ in fields)
        )
    if current.get("role") is not None and current["role"] not in AGENT_ROLES:
        fail(f"--role must be one of {sorted(AGENT_ROLES)}")
    write_registry(registry)
    print(f"updated {ticket}: " + ", ".join(f"{k}={current[k]}" for k in changed))


def cmd_agent_orch(args: argparse.Namespace) -> None:
    import os

    orch_id = args.id.strip()
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]*", orch_id):
        fail("orch id must be alphanumeric/dash/underscore")
    session_id = os.environ.get("CLAUDE_CODE_SESSION_ID")
    cwd = Path.cwd()
    transcript = None
    if session_id:
        escaped = str(cwd).replace("/", "-").replace(".", "-")
        candidate = Path.home() / ".claude" / "projects" / escaped / f"{session_id}.jsonl"
        transcript = str(candidate)
    registry = read_registry()
    if is_headless_current(registry.get(orch_id)):
        fail_headless_ownership("wiki agent orch", orch_id)
    orchs = registry.setdefault("_orchestrators", {})
    orchs[orch_id] = {
        "window": args.window,
        "model": args.model,
        "cwd": str(cwd),
        "session_id": session_id,
        "transcript": transcript,
        "spawned_at": now_iso(),
    }
    write_registry(registry)
    note = transcript if transcript else "WARNING: CLAUDE_CODE_SESSION_ID not set — no transcript mapping"
    print(f"orchestrator {orch_id} registered ({note})")


def cmd_agent_orch_done(args: argparse.Namespace) -> None:
    orch_id = args.id.strip()
    registry = read_registry()
    orchs = registry.get("_orchestrators", {})
    if orch_id not in orchs:
        fail(f"{orch_id} not registered")
    del orchs[orch_id]
    write_registry(registry)
    print(f"orchestrator {orch_id} deregistered")


def cmd_agent_outcome(args: argparse.Namespace) -> None:
    ticket = args.ticket.strip().upper()
    if args.outcome not in AGENT_OUTCOMES:
        fail(f"outcome must be one of {sorted(AGENT_OUTCOMES)}")
    meta_path = persist_outcome(ticket, args.outcome)
    if meta_path is None:
        fail(f"no archive dir for {ticket} under {AGENT_ARCHIVE}")
    print(f"marked {ticket} {args.outcome} ({meta_path})")


def cmd_agent_list(_args: argparse.Namespace) -> None:
    registry = read_registry()
    if not registry:
        print("no registered agents")
        return
    for orch_id, orch in sorted(registry.get("_orchestrators", {}).items()):
        print(f"[orch] {orch_id}: {orch.get('window', '?')} {orch.get('cwd', '?')}")
    for ticket, entry in sorted(registry.items()):
        if ticket.startswith("_"):
            continue
        current = entry.get("current") or {}
        sessions = len(entry.get("history", [])) + (1 if current else 0)
        print(
            f"{ticket}: {current.get('kind', '?')} {current.get('role', '?')} "
            f"{current.get('window', '?')} (session {current.get('session', '?')}/{sessions})"
        )


class WatchBackendError(RuntimeError):
    """The local Wiki backend could not provide a worker snapshot."""


class GateError(RuntimeError):
    """A merge-gate input could not be collected."""


def _backend_url() -> str:
    configured = os.environ.get("WIKI_BACKEND_URL")
    if configured:
        try:
            return backend_runtime.normalize_loopback_url(configured)
        except ValueError as exc:
            raise WatchBackendError(str(exc)) from exc
    configured_port = os.environ.get("WIKI_BACKEND_PORT")
    if configured_port:
        candidates = [f"http://127.0.0.1:{configured_port}"]
    else:
        candidates = []
        discovered = backend_runtime.read_backend_url()
        if discovered:
            candidates.append(discovered)
        candidates.extend(("http://127.0.0.1:8213", "http://127.0.0.1:8011"))
    tried: list[str] = []
    for candidate in dict.fromkeys(candidates):
        try:
            normalized = backend_runtime.normalize_loopback_url(candidate)
            with urlopen(  # noqa: S310 - loopback URLs validated above
                f"{normalized}/health",
                timeout=0.5,
            ) as response:
                payload = json.loads(response.read().decode("utf-8"))
            if isinstance(payload, dict) and payload.get("status") == "ok":
                return normalized
        except (HTTPError, URLError, OSError, ValueError):
            tried.append(candidate)
    raise WatchBackendError(
        "no live Wiki backend found; tried " + ", ".join(tried or candidates)
    )


def nonnegative_seconds(value: str) -> float:
    try:
        seconds = float(value)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a number") from exc
    if seconds < 0:
        raise argparse.ArgumentTypeError("must be non-negative")
    return seconds


def normalized_cli_ticket(value: str) -> str:
    ticket = value.strip().upper()
    if CLI_TICKET_RE.fullmatch(ticket):
        return ticket
    print("error: ticket must match [A-Za-z0-9_-]+", file=sys.stderr)
    raise SystemExit(2)


def normalized_pr_reference(value: str) -> str:
    reference = value.strip()
    if PR_REFERENCE_RE.fullmatch(reference):
        return reference
    print("error: PR must be a number or a github.com pull-request URL", file=sys.stderr)
    raise SystemExit(2)


def _backend_request(
    method: str,
    path: str,
    payload: dict | None = None,
) -> dict:
    try:
        return backend_runtime.request_json(
            _backend_url(),
            method,
            path,
            payload,
        )
    except (backend_runtime.BackendRequestError, ValueError) as exc:
        raise WatchBackendError(str(exc)) from exc


def _backend_json(path: str) -> dict:
    return _backend_request("GET", path)


def _backend_post(path: str, payload: dict | None = None) -> dict:
    return _backend_request("POST", path, payload)


def _read_cli_text(path_value: str, *, label: str) -> str:
    path = Path(path_value).expanduser()
    try:
        text = path.read_text(encoding="utf-8")
    except OSError as exc:
        fail(f"could not read {label} {path}: {exc}")
    if not text.strip():
        fail(f"{label} must not be empty")
    return text


def _request_id(value: str | None) -> str:
    request_id = (value or "").strip() or str(uuid4())
    if len(request_id) > 200:
        fail("--request-id must be at most 200 characters")
    return request_id


def _validate_steer_document(document: dict) -> None:
