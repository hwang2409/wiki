    rebuild = index_sub.add_parser(
        "rebuild",
        help="drop and rebuild the index (supervisor archives only by default)",
    )
    rebuild.add_argument(
        "--include-legacy",
        action="store_true",
        default=None,
        help="also index pre-headless tmux archives (or set WIKI_KNOWLEDGE_INCLUDE_LEGACY=1)",
    )
    rebuild.set_defaults(func=cmd_index_rebuild)

    args = parser.parse_args()
    args.func(args)
    if getattr(args, "refresh_knowledge", False):
        # The transactional operation has already completed and printed its
        # response. This only enqueues work for the backend indexer.
        knowledge.enqueue_refresh(runtime_dir=os.environ.get("WIKI_AGENT_RUNTIME_DIR"))


if __name__ == "__main__":
    main()
