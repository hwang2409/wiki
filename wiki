#!/usr/bin/env python3
"""wiki — structured vault ops for agents.

Hot-path writes with validation, so conventions hold mechanically:

  wiki todo add "text" [--priority P1] [--section Todo] [--if-missing]
  wiki todo move "substring" --to "In Progress"
  wiki todo complete "substring" [--done-line "terse completion"]
  wiki agent spawn <ticket> --kind cdx --role implement --model gpt-5.4 --effort high --prompt-file prompt.md --workdir /path
  wiki agent steer <id> --message "text" [--mode now|on-idle]
  wiki graph lint <path> [--schema finding|verdict|steer|edge|workgraph]
  wiki graph select-template <ticket-id> [--json]  # unknown prefixes exit 2
  wiki agent replace <id> [--kind cc|cdx] [--model model] [--effort effort]
  wiki agent archive <id> --outcome merged|closed|abandoned
  wiki agent watch <ticket> [--json] [--until merge-ready|terminal|merged]
  wiki gate <pr-number> [--expect-sha SHA] [--json]
  wiki graph append <TICKET> --edge-kind spawn --from N-1 --to N-2 --payload-file /tmp/spawn.json
  wiki graph health <TICKET> [--cap 8] [--json]
  wiki graph recover <TICKET>
  wiki log-done "project: summary (links)"
  wiki note new <topic>/<slug> --type til --hook "map hook line" [--title T] [--tags a,b]
  wiki lint

Raw markdown editing stays allowed for note prose; these commands cover the
transactional flows (todo/done/map) where drift actually happens.
"""

