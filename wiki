    payload_path = Path(args.payload_file)
    try:
        payload = json.loads(payload_path.read_text(encoding="utf-8"))
    except OSError as exc:
        fail(f"cannot read {payload_path}: {exc}")
    except ValueError as exc:
        fail(f"{payload_path} is not valid JSON: {exc}")

    try:
        graph = workgraph.append_edge(
            ticket,
            args.edge_kind,
            args.from_node,
            args.to_node,
            payload,
            orch=args.orch or _registry_orch(ticket),
            template=args.template,
            status_dir=AGENT_STATUS_DIR,
        )
    except workgraph.WorkgraphError as exc:
        fail(str(exc))

    health = graph["composite_health"]
    snapshot = graph.pop("_snapshot_path", None)
    if graph.pop("_replayed", False):
        print(
            f"{ticket}: {args.edge_kind} {args.from_node}->{args.to_node} matches the "
            f"newest edge; treated as a retry replay, nothing appended"
        )
        return
    print(
        f"{ticket}: appended {args.edge_kind} {args.from_node}->{args.to_node} "
        f"(edge #{len(graph['edges'])})"
    )
    print(
        f"health: state={health['state']} open_findings={health['open_findings']} "
        f"blocking={health['blocking']} stall={health['slowest_node_stall_seconds']}s "
        f"iterations={health['iteration_count']}"
    )
    print(f"hot: {workgraph.hot_path(ticket, AGENT_STATUS_DIR)}")
    if snapshot:
        print(f"snapshot: {snapshot}")


def cmd_graph_health(args: argparse.Namespace) -> None:
    from backend.app import workgraph

    ticket = args.ticket.strip().upper()
    source = "live"
    try:
        graph = workgraph.load_workgraph(ticket, AGENT_STATUS_DIR)
    except workgraph.WorkgraphCorruptError as exc:
        print(f"warning: {exc}", file=sys.stderr)
        graph = None
    if graph is None:
        graph = workgraph.load_snapshot(ticket)
        source = "snapshot"
    if graph is None:
        fail(f"no workgraph found for {ticket} (hot or snapshot)")
    current = workgraph.current_health(graph, iteration_cap=args.cap)
    health = current["health"]
    alarms = current["alarms"]
    if args.json:
        print(
            json.dumps(
                {
                    "ticket": ticket,
                    "source": source,
                    "health": health,
                    "alarms": alarms,
                    "computed_at": current["computed_at"],
                },
                sort_keys=True,
            )
        )
    else:
        print(
            f"{ticket} [{source}]: state={health['state']} open_findings={health['open_findings']} "
            f"blocking={health['blocking']} stall={health['slowest_node_stall_seconds']}s "
            f"iterations={health['iteration_count']}"
        )
        for alarm in alarms:
            print(f"alarm: {alarm['check']}: {alarm['message']}")
    raise SystemExit(2 if alarms else 0)


