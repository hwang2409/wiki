{
  "template_id": "phoebe.plan",
  "applies_to": {"repo": "phoebe", "labels_any": ["plan"], "labels_none": ["frontend", "migration"]},
  "roles": [
    {"kind": "plan", "runtime": "cdx", "model": "gpt-5.6-luna", "effort": "high"}
  ],
  "edges": [
    {"kind": "spawn", "from": "orchestrator", "to": "plan"},
    {"kind": "monitor", "on": "plan"},
    {"kind": "verdict", "from": "plan", "to": "orchestrator", "trigger": "plan.state == 'plan-ready'"},
    {"kind": "archive", "from": "orchestrator", "to": "plan", "trigger": "verdict.routed"}
  ],
  "iteration_cap": 8,
  "on_failure": {
    "implement_stall_30min": "steer_ping",
    "review_no_verdict_2h": "replace_review",
    "iteration_cap_reached": "escalate_to_henry"
  }
}
